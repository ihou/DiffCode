# DiffCode Mac App Store 版：签名、打包与上传的配置。
# 复制为 release/appstore/.appstore.env（已被 git 忽略）后使用，把 YOUR_… 占位符换成自己的值。

TEAM_ID=YOUR_TEAM_ID
BUNDLE_ID=com.nanshanbei.DiffCode
DIST_DIR=dist/appstore

# App Store Connect API Key（注册 bundle ID、建证书和描述文件、上传构建都用它）。
# 必填：ASC_KEY_PATH 写 .p8 的路径；相对路径按本文件所在目录解析。切勿提交 .p8。
ASC_KEY_ID=YOUR_KEY_ID
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
ASC_KEY_PATH=AuthKey_YOUR_KEY_ID.p8

# 一般不用改：脚本会自动找钥匙串里有效的证书（跳过已吊销的）。
# APP_SIGN_IDENTITY=<Apple Distribution 证书的 SHA-1>
# INSTALLER_SIGN_IDENTITY=<Mac Installer Distribution 证书的 SHA-1>
# 描述文件；setup_signing.sh 会下载到这里。
PROVISIONING_PROFILE=profiles/DiffCode_Mac_App_Store.provisionprofile
