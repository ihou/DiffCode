# DiffCode 官网下载版：构建、公证与 Sparkle 发布的统一配置。
# 复制为 release/macos/.macos.env（已被 git 忽略）后使用，把 YOUR_… 和 your-… 占位符换成自己的值：
# 1. TEAM_ID 和公证用的 NOTARY_PROFILE 或 NOTARY_KEY_*
# 2. 发布 Sparkle 更新时才需要的 R2_*（access key 和 secret 切勿提交）

# 构建配置
TEAM_ID=YOUR_TEAM_ID
APP_NAME=DiffCode
DIST_DIR=dist/macos
RUN_RELEASE_BUILD=1
SKIP_VALIDATION=1
# PKG_INSTALL_LOCATION 必须是 /（root-based payload），请勿改为 /Applications
PKG_INSTALL_LOCATION=/

# 公证二选一：优先用 NOTARY_PROFILE；不填则用下面的 API Key。
# AuthKey_*.p8 放在本文件同目录；也可以放在仓库外，用 SHARED_NOTARY_KEY_PATH 写它的绝对路径。
# NOTARY_PROFILE=YourNotaryProfile
NOTARY_KEY_ID=YOUR_KEY_ID
NOTARY_ISSUER_ID=00000000-0000-0000-0000-000000000000
NOTARY_KEY_PATH=AuthKey_YOUR_KEY_ID.p8
# SHARED_NOTARY_KEY_PATH=/absolute/path/outside/the/repo/AuthKey_YOUR_KEY_ID.p8

# 一般不用改；自动识别证书失败时再填写。
# DEVELOPER_ID_APP=Developer ID Application: your name (TEAMID)
# DEVELOPER_ID_INSTALLER=Developer ID Installer: your name (TEAMID)

# Sparkle 发布配置
# 发布前是否先重新构建并公证（1 = 是）
BUILD_BEFORE_UPGRADE=1
APPCAST_FILENAME=appcast.xml
R2_PREFIX=diffcode/macos/stable
R2_BUCKET=your-bucket
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto
# 必填：R2 的 access key 和 secret（发布时才用到，切勿提交）
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://r2-public.nanshanbei.com

# sign_update 默认用 SwiftPM 下载的 Sparkle 工具；私钥默认从钥匙串读取。
SPARKLE_SIGN_UPDATE_BIN=
SPARKLE_PRIVATE_KEY_FILE=

# 可选项
# SPARKLE_CHANNEL=stable
SPARKLE_MINIMUM_SYSTEM_VERSION=14.0
# SKIP_REMOTE_VERSION_CHECK=1
# RELEASE_NOTES_FILE=release/macos/release-notes/0.1.0.html
# RELEASE_TITLE=DiffCode 0.1.0
